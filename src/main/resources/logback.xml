<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.config/OsuSkinTool/logs/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.config/OsuSkinTool/logs/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Logger for application packages -->
    <logger name="com.osuskin.tool" level="WARN"/>
    
    <!-- Critical components - only errors and warnings -->
    <logger name="com.osuskin.tool.controller.MainController" level="WARN"/>
    <logger name="com.osuskin.tool.service.SkinElementLoader" level="WARN"/>
    <logger name="com.osuskin.tool.service.SkinScannerService" level="WARN"/>
    <logger name="com.osuskin.tool.service.HitsoundGeneratorService" level="WARN"/>
    <logger name="com.osuskin.tool.service.ImprovedHitsoundRenderer" level="WARN"/>
    <logger name="com.osuskin.tool.service.ArrangementPlayer" level="WARN"/>
    <logger name="com.osuskin.tool.service.AudioMixer" level="WARN"/>
    <logger name="com.osuskin.tool.service.OggDecoder" level="WARN"/>
    <logger name="com.osuskin.tool.view.SimpleGameplayRenderer" level="ERROR"/>
    <logger name="com.osuskin.tool.view.gameplay" level="ERROR"/>
    <logger name="com.osuskin.tool.service.AudioMixerService" level="WARN"/>
    
    <!-- Performance-critical components - show important events only -->
    <logger name="com.osuskin.tool.service.AsyncPreviewLoader" level="WARN"/>
    <logger name="com.osuskin.tool.service.AsyncSkinLoader" level="WARN"/>
    <logger name="com.osuskin.tool.service.PriorityLoader" level="ERROR"/>
    <logger name="com.osuskin.tool.service.SkinIndexCache" level="WARN"/>
    
    <!-- Startup/shutdown logging -->
    <logger name="com.osuskin.tool.OsuSkinToolApplication" level="WARN"/>
    
    <!-- Performance monitoring - always show when enabled -->
    <logger name="com.osuskin.tool.util.PerformanceMonitor" level="WARN"/>
    
    <!-- Root logger -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
</configuration>