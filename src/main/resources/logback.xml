<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.config/OsuSkinTool/logs/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.config/OsuSkinTool/logs/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Logger for application packages -->
    <logger name="com.osuskin.tool" level="INFO"/>
    
    <!-- Granular control for specific classes/packages -->
    <!-- Set these to DEBUG to see detailed loading information -->
    <logger name="com.osuskin.tool.service.SkinElementLoader" level="WARN"/>
    <logger name="com.osuskin.tool.service.SkinScannerService" level="INFO"/>
    <logger name="com.osuskin.tool.service.HitsoundGeneratorService" level="INFO"/>
    <logger name="com.osuskin.tool.view.SimpleGameplayRenderer" level="INFO"/>
    <logger name="com.osuskin.tool.view.gameplay" level="INFO"/>
    <logger name="com.osuskin.tool.service.AudioMixerService" level="INFO"/>
    
    <!-- Performance-related logging (set to DEBUG when optimizing) -->
    <logger name="com.osuskin.tool.service.AsyncSkinLoader" level="INFO"/>
    <logger name="com.osuskin.tool.service.PriorityLoader" level="INFO"/>
    <logger name="com.osuskin.tool.service.SkinIndexCache" level="INFO"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
</configuration>